# 复制为 .env 填好（.env 已 gitignored，永不提交）
cp .env.example .env

# —— 华为云凭证（控制台「我的凭证 → 访问密钥」创建/下载 CSV 后抄入）——
# 上传代码目录 / 下载产物脚本用它；训练容器内不使用（容器用平台临时凭证）
HW_AK=
HW_SK=

# —— 目标桶与区域（代码目录上传 / 产物下载共用）——
OBS_BUCKET=posttrain
REGION=cn-north-4

# —— HF 镜像（国内机器拉基模加速；国外机器可删掉这行走官方源）——
HF_ENDPOINT=https://hf-mirror.com
